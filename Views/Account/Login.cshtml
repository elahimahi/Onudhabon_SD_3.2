@model Onudhabon.Models.LoginViewModel

@{
    Layout = null;
    ViewData["Title"] = "Sign In - Onudhabon";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/png" href="~/images/tab_logo.png" asp-append-version="true" />
    <link rel="shortcut icon" type="image/png" href="~/images/tab_logo.png" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/images/tab_logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body>
    <div class="login-page-container">
        <div class="login-card">
            <!-- Logo Section -->
            <div class="logo-section">
                <a asp-controller="Home" asp-action="Index" class="logo-link">
                    <img src="~/images/login_logo.png" asp-append-version="true" alt="Onudhabon Logo" class="logo-icon" />
                </a>
                <h1 class="app-title">Onudhabon</h1>
                <div class="subtitle">Exploring Education</div>
                <p class="mission-text">Join our mission to explore education</p>
            </div>

            <!-- Segmented Control Tabs -->
            <div class="tabs-container">
                <div class="tabs-segment">
                    <a asp-controller="Account" asp-action="Login" class="tab-btn active">Login</a>
                    <a asp-controller="Account" asp-action="Register" class="tab-btn">Register</a>
                </div>
            </div>

            <!-- Feedback Alerts -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert-custom alert-success" role="alert">
                    <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
                    </svg>
                    <span>@TempData["SuccessMessage"]</span>
                </div>
            }

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
            {
                <div class="alert-custom alert-danger" role="alert">
                    <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                        <path d="M7.002 11a1 1 0 1 1 2 0 1 1 0 0 1-2 0zM7.1 4.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 4.995z"/>
                    </svg>
                    <div asp-validation-summary="ModelOnly" class="mb-0"></div>
                </div>
            }

            <div class="alert alert-info py-2 small" role="status">New accounts usually require administrator approval. For demonstration purposes, approval is temporarily automatic after email verification.</div>

            <!-- Login Form -->
            <div class="form-panel">
                <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div class="form-group">
                        <label asp-for="UsernameOrEmail" class="form-label">Email or Username</label>
                        <div class="input-icon-wrapper">
                            <span class="input-icon">
                                <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207" />
                                </svg>
                            </span>
                            <input asp-for="UsernameOrEmail" class="auth-input" placeholder="name@example.com or username" autocomplete="username" />
                        </div>
                        <span asp-validation-for="UsernameOrEmail" class="validation-error-text"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Password" class="form-label">Password</label>
                        <div class="input-icon-wrapper">
                            <span class="input-icon">
                                <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                                </svg>
                            </span>
                            <input asp-for="Password" type="password" id="loginPasswordInput" class="auth-input" placeholder="Enter your password" autocomplete="current-password" />
                            <button type="button" class="password-toggle-btn" onclick="togglePasswordVisibility('loginPasswordInput', this)" aria-label="Toggle password visibility">
                                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="validation-error-text"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <label class="custom-checkbox-label">
                            <input type="checkbox" asp-for="RememberMe" />
                            <span>Remember me</span>
                        </label>
                        <a asp-controller="Account" asp-action="ForgotPassword" class="forgot-password-link">Forgot password?</a>
                    </div>

                    <button type="submit" class="btn-submit">
                        <span>Sign In</span>
                        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                        </svg>
                    </button>
                </form>
            </div>

            <!-- Guest Link -->
            <div class="guest-link-wrapper">
                <a asp-controller="Home" asp-action="Index" class="guest-link">
                    <span>Continue as Guest</span>
                    <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                </a>
            </div>
        </div>

        <div class="fixed-bottom-copyright">
            &copy; @DateTime.Now.Year Onudhabon. All rights reserved.
        </div>
    </div>

    <!-- Status Notification Modal (Pop-up for Declined / Restricted / Pending / Unverified Volunteers) -->
    @if (ViewBag.ModalMessage != null)
    {
        <div class="modal fade" id="statusNotificationModal" tabindex="-1" aria-labelledby="statusNotificationModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content rounded-4 border-0 shadow-lg p-3">
                    <div class="modal-header border-bottom-0 pb-0">
                        <div class="rounded-circle p-2.5 @(ViewBag.RestrictedModal == true ? "bg-danger-subtle text-danger" : (ViewBag.UnverifiedEmailModal == true ? "bg-primary-subtle text-primary" : (ViewBag.PendingModal == true ? "bg-warning-subtle text-warning" : "bg-danger-subtle text-danger"))) me-2 d-inline-flex align-items-center justify-content-center">
                            @if (ViewBag.UnverifiedEmailModal == true)
                            {
                                <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                                </svg>
                            }
                            else if (ViewBag.PendingModal == true)
                            {
                                <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                            }
                            else
                            {
                                <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                                </svg>
                            }
                        </div>
                        <h5 class="modal-title fw-bold text-dark" id="statusNotificationModalLabel">@(ViewBag.ModalTitle ?? "Account Status Notice")</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body py-3">
                        <p class="text-secondary mb-0" style="font-size: 0.98rem; line-height: 1.6;">@ViewBag.ModalMessage</p>
                        
                        @if (ViewBag.UnverifiedEmailModal == true && !string.IsNullOrEmpty(ViewBag.UnverifiedEmail as string))
                        {
                            <div class="mt-3 p-3 rounded-3 border" style="background-color: #f8fafc;">
                                <div class="small text-muted mb-2">Need to verify your email or didn't receive the OTP?</div>
                                <div class="d-flex flex-wrap gap-2">
                                    <a asp-controller="Account" asp-action="VerifyOtp" asp-route-email="@ViewBag.UnverifiedEmail" class="btn btn-sm btn-primary rounded-pill px-3 py-1.5 fw-semibold d-inline-flex align-items-center gap-1.5" style="background: linear-gradient(135deg, #1e3a8a 0%, #1d4ed8 100%); border: none;">
                                        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                                        </svg>
                                        <span>Enter 6-Digit OTP</span>
                                    </a>
                                    <form asp-controller="Account" asp-action="ResendOtp" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="email" value="@ViewBag.UnverifiedEmail" />
                                        <button type="submit" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1.5 fw-semibold d-inline-flex align-items-center gap-1.5">
                                            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                                            </svg>
                                            <span>Resend OTP Email</span>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="modal-footer border-top-0 pt-0 d-flex justify-content-between align-items-center">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary rounded-pill px-3 py-2 text-decoration-none d-inline-flex align-items-center gap-1.5 font-weight-medium">
                            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                            </svg>
                            <span>Browse Pages as Guest</span>
                        </a>
                        <button type="button" class="btn btn-primary rounded-pill px-4 py-2" data-bs-dismiss="modal">Acknowledge & Close</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        $(document).ready(function() {
            var modalEl = document.getElementById('statusNotificationModal');
            if (modalEl) {
                var modal = new bootstrap.Modal(modalEl);
                modal.show();
            }
        });

        // Prevent back-button from restoring login page from browser cache (BFCache)
        window.addEventListener('pageshow', function (event) {
            if (event.persisted || (window.performance && window.performance.getEntriesByType("navigation")[0]?.type === "back_forward")) {
                window.location.reload();
            }
        });

        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <text>
            // If restored from browser memory cache while authenticated, immediately forward
            var userRole = '@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "")';
            if (userRole === 'Admin') {
                window.location.replace('/Admin/Dashboard');
            } else if (userRole === 'Local Guardian') {
                window.location.replace('/Student/Index');
            } else if (userRole === 'Educator') {
                window.location.replace('/Lecture/Index');
            } else {
                window.location.replace('/Home/Index');
            }
            </text>
        }

        function togglePasswordVisibility(inputId, btn) {
            const input = document.getElementById(inputId);
            if (input.type === 'password') {
                input.type = 'text';
                btn.innerHTML = `
                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
                    </svg>`;
            } else {
                input.type = 'password';
                btn.innerHTML = `
                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                    </svg>`;
            }
        }
    </script>
</body>
</html>
