@model Onudhabon.Models.StudentProgressViewModel

@{
    ViewData["Title"] = "Track Student Progress - Onudhabon";
}

<style>
    @@media print {
        .progress-no-print, .navbar, footer, .chat-fab, #chat-widget, .modal { display: none !important; }
        body, .container { background: #fff !important; }
        .student-progress-card { break-inside: avoid; box-shadow: none !important; border: 1px solid #ddd !important; }
        .student-progress-card canvas { max-width: 130px !important; max-height: 130px !important; }
    }
</style>

<div class="container py-5">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Home</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Student" asp-action="Index" class="text-decoration-none">Students</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Progress Tracker</li>
                </ol>
            </nav>
            <h2 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                <i class="bi bi-graph-up-arrow text-primary"></i> Track Student Progress
            </h2>
            <p class="text-muted mb-0">@(Model.IsAdminView ? "Review learning progress across enrolled students and volunteer updates." : "View progress reports for students registered under your guardianship.")</p>
        </div>

        <div class="d-flex gap-2 flex-wrap progress-no-print">
            <button type="button" onclick="window.print()" class="btn btn-outline-primary rounded-pill px-3.5 py-2 small shadow-sm d-inline-flex align-items-center gap-1.5">
                <i class="bi bi-printer"></i><span>Print report</span>
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3.5 py-2 small shadow-sm d-inline-flex align-items-center gap-1.5">
                <i class="bi bi-person-lines-fill"></i>
                <span>All Enrolled List</span>
            </a>
            <a asp-action="Enroll" class="btn btn-primary rounded-pill px-4 py-2 shadow-sm d-inline-flex align-items-center gap-2">
                <i class="bi bi-person-plus-fill"></i>
                <span>Enroll New Student</span>
            </a>
        </div>
    </div>

    <!-- Feedback Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search & Filter Bar -->
    <div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white progress-no-print">
        <form method="get" asp-action="Progress" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 rounded-start-pill text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchQuery" value="@Model.SearchQuery" class="form-control bg-light border-start-0 rounded-end-pill" placeholder="Search by student name, birth cert ID, father..." />
                </div>
            </div>

            <div class="col-md-2">
                <select name="selectedClass" class="form-select rounded-pill">
                    <option value="">All Classes</option>
                    @for (int i = 1; i <= 12; i++)
                    {
                        var isSelected = (Model.SelectedClass?.Replace("Class", "").Trim() == i.ToString());
                        <option value="@i" selected="@isSelected">Class @i</option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <select name="selectedSubject" class="form-select rounded-pill">
                    <option value="">All Subjects</option>
                    @foreach (var subject in Model.AvailableSubjects)
                    {
                        <option value="@subject" selected="@(Model.SelectedSubject == subject)">@subject</option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <select name="progressStatus" class="form-select rounded-pill">
                    <option value="">Any Progress</option>
                    <option value="not-started" selected="@(Model.ProgressStatus == "not-started")">Not started</option>
                    <option value="in-progress" selected="@(Model.ProgressStatus == "in-progress")">In progress</option>
                    <option value="complete" selected="@(Model.ProgressStatus == "complete")">Complete</option>
                </select>
            </div>

            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary rounded-pill px-3 flex-grow-1">Filter</button>
                @if (!string.IsNullOrWhiteSpace(Model.SearchQuery) || !string.IsNullOrWhiteSpace(Model.SelectedClass) || !string.IsNullOrWhiteSpace(Model.SelectedSubject) || !string.IsNullOrWhiteSpace(Model.ProgressStatus))
                {
                    <a asp-action="Progress" class="btn btn-outline-secondary rounded-pill px-3">Clear</a>
                }
            </div>
        </form>
    </div>

    @if (Model.Cards.Any())
    {
        var totalStudents = Model.Cards.Count;
        var avgProgress = totalStudents > 0 ? Model.Cards.Average(c => c.OverallProgressPercent) : 0.0;
        var curriculumComplete = Model.Cards.Count(c => c.OverallProgressPercent >= 100.0 && !c.IsDeclined);
        var totalLecturesCompleted = Model.Cards.Sum(c => c.CompletedLectures);

        <!-- Top SaaS KPI Metrics Ribbon -->
        <div class="row g-3 mb-4">
            <div class="col-6 col-lg-3">
                <div class="saas-metric-card highlight-primary">
                    <div>
                        <div class="metric-header">
                            <span class="metric-title">@(Model.IsAdminView ? "Students Tracked" : "Enrolled Students")</span>
                            <div class="metric-icon-badge bg-primary-subtle text-primary">
                                <i class="bi bi-mortarboard-fill"></i>
                            </div>
                        </div>
                        <div class="metric-value">@totalStudents</div>
                    </div>
                    <div class="metric-subtext">
                        <i class="bi bi-person-check text-primary"></i>
                        <span>@(Model.IsAdminView ? "Across enrolled students" : "Under your guardianship")</span>
                    </div>
                </div>
            </div>

            <div class="col-6 col-lg-3">
                <div class="saas-metric-card highlight-success">
                    <div>
                        <div class="metric-header">
                            <span class="metric-title">Average Progress</span>
                            <div class="metric-icon-badge bg-success-subtle text-success">
                                <i class="bi bi-graph-up-arrow"></i>
                            </div>
                        </div>
                        <div class="metric-value text-success">@avgProgress.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%</div>
                    </div>
                    <div class="metric-subtext">
                        <i class="bi bi-check2-circle text-success"></i>
                        <span>Across all curriculum subjects</span>
                    </div>
                </div>
            </div>

            <div class="col-6 col-lg-3">
                <div class="saas-metric-card highlight-warning">
                    <div>
                        <div class="metric-header">
                            <span class="metric-title">Curriculum Complete</span>
                            <div class="metric-icon-badge bg-warning-subtle text-warning">
                                <i class="bi bi-award-fill"></i>
                            </div>
                        </div>
                        <div class="metric-value text-warning-emphasis">@curriculumComplete</div>
                    </div>
                    <div class="metric-subtext">
                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-2.5 py-0.5">
                            <i class="bi bi-check2-all me-1"></i>All planned lectures complete
                        </span>
                    </div>
                </div>
            </div>

            <div class="col-6 col-lg-3">
                <div class="saas-metric-card highlight-rose">
                    <div>
                        <div class="metric-header">
                            <span class="metric-title">Lectures Completed</span>
                            <div class="metric-icon-badge" style="background-color: #fdf2f8; color: #e2136e;">
                                <i class="bi bi-play-circle-fill"></i>
                            </div>
                        </div>
                        <div class="metric-value" style="color: #be185d;">@totalLecturesCompleted</div>
                    </div>
                    <div class="metric-subtext">
                        <i class="bi bi-check-all text-secondary"></i>
                        <span>Total lecture milestones finished</span>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Main Section: My Students -->
    <div class="mb-4">
        <h4 class="fw-bold text-dark mb-3">My Students</h4>

        @if (!Model.Cards.Any())
        {
            <div class="card border-0 shadow-sm rounded-4 text-center py-5 px-4 bg-white">
                <div class="rounded-circle bg-primary-subtle text-primary d-inline-flex p-4 mx-auto mb-3">
                    <svg width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
                    </svg>
                </div>
                <h5 class="fw-bold text-dark">No Students Found</h5>
                <p class="text-muted mx-auto mb-4" style="max-width: 480px;">
                    No student records match your filter criteria. Enroll students under your local guardianship to begin tracking their subject and lecture progress.
                </p>
                <div>
                    <a asp-action="Enroll" class="btn btn-primary rounded-pill px-4 py-2 shadow-sm">
                        Enroll New Student
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var card in Model.Cards)
                {
                    var student = card.Student;
                    var donutId = $"donutChart_{student.Id}";
                    var barId = $"barChart_{student.Id}";
                    var overallPercent = card.OverallProgressPercent;

                    <div class="col-lg-4 col-md-6">
                        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white d-flex flex-column p-4 student-progress-card">
                            <!-- Card Header Info -->
                            <div class="mb-3">
                                <h5 class="fw-bold text-dark mb-1">@student.FullName</h5>
                                <div class="text-muted small mb-0.5">
                                    Birth Cert ID: @(string.IsNullOrWhiteSpace(student.BirthCertificateId) ? "N/A" : student.BirthCertificateId)
                                </div>
                                <div class="text-muted small mb-0.5">
                                    Current Class: @(student.ClassLevel?.Replace("Class", "").Trim() ?? "1")
                                </div>
                                <div class="text-muted small mb-1">
                                    Enrollment Year: @(student.EnrollmentYear ?? "2025")
                                </div>
                                <div class="text-muted small pt-1 border-top">
                                    <span class="text-dark fw-medium">Enrolled Subjects:</span>
                                    <span class="text-secondary">@(string.IsNullOrWhiteSpace(student.Subjects) ? (card.SubjectProgress.Any() ? string.Join(", ", card.SubjectProgress.Select(s => s.SubjectName)) : "General Curriculum") : student.Subjects)</span>
                                </div>
                                @if (!card.IsDeclined)
                                {
                                    <div class="d-flex gap-2 flex-wrap progress-no-print mt-2">
                                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill" onclick="openAiProgressModal(@student.Id, '@student.FullName.Replace("'", "\\'")')">
                                            <i class="bi bi-stars me-1"></i>Update from volunteer note with AI
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-success rounded-pill" onclick="getAiLearningSummary(@student.Id)">
                                            <i class="bi bi-lightbulb me-1"></i>AI learning summary
                                        </button>
                                    </div>
                                }
                            </div>

                            <!-- Academic Grade & Exam Evaluation Section (Grade Part) -->
                            <div class="p-2.5 rounded-3 border mb-3 bg-light-subtle exam-grade-card" id="examGradeCard_@student.Id" style="border-left: 4px solid #6366f1 !important;">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <div class="d-flex align-items-center gap-1.5">
                                        <div class="p-1 rounded-circle d-flex align-items-center justify-content-center" style="width: 26px; height: 26px; background-color: #e0e7ff; color: #4338ca;">
                                            <i class="bi bi-award-fill" style="font-size: 0.85rem;"></i>
                                        </div>
                                        <span class="fw-bold text-dark" style="font-size: 0.88rem;">Academic Grade</span>
                                    </div>
                                    <div id="overallGradeBadgeWrap_@student.Id">
                                        @if (card.HasExamEvaluation)
                                        {
                                            <span class="badge @card.OverallGradeBadgeClass px-2.5 py-1 fw-bold rounded-pill" style="font-size: 0.82rem;" id="overallGradeBadge_@student.Id">
                                                Grade: @card.OverallGrade
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border px-2 py-1 rounded-pill small" id="overallGradeBadge_@student.Id">
                                                Not Evaluated
                                            </span>
                                        }
                                    </div>
                                </div>
                                <div class="d-flex justify-content-between align-items-center text-muted" style="font-size: 0.76rem;">
                                    <span>
                                        GPA: <strong class="text-dark" id="overallGpaText_@student.Id">@(card.OverallGPA ?? "N/A")</strong>
                                    </span>
                                    <span>
                                        Evaluated: <strong class="text-dark" id="evaluatedCountText_@student.Id">@card.EvaluatedSubjectsCount</strong>/@card.SubjectProgress.Count subjects
                                    </span>
                                </div>
                            </div>

                            <!-- Overall Progress Section -->
                            <div class="mb-3 text-center">
                                <h6 class="fw-bold text-dark text-start mb-2" style="font-size: 0.95rem;">Overall Progress</h6>
                                <div class="position-relative d-inline-block mx-auto my-2" style="width: 170px; height: 170px;">
                                    <canvas id="@donutId" width="170" height="170"></canvas>
                                    <div class="position-absolute top-50 start-50 translate-middle text-center pointer-events-none">
                                        <div class="fw-bold text-dark" style="font-size: 1.15rem;" id="overallPercentText_@student.Id">
                                            @overallPercent.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%
                                        </div>
                                    </div>
                                </div>

                                <!-- Donut Legend matching the mockup -->
                                <div class="d-flex justify-content-center align-items-center gap-3 small text-muted mt-1">
                                    <span class="d-inline-flex align-items-center gap-1.5" style="font-size: 0.75rem;">
                                        <span class="d-inline-block rounded-1" style="width: 12px; height: 6px; background-color: #38bdf8;"></span>
                                        Completed
                                    </span>
                                    <span class="d-inline-flex align-items-center gap-1.5" style="font-size: 0.75rem;">
                                        <span class="d-inline-block rounded-1" style="width: 12px; height: 6px; background-color: #e2e8f0;"></span>
                                        Remaining
                                    </span>
                                </div>
                            </div>

                            <!-- Per Subject Progress Section -->
                            <div class="mb-4">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="fw-bold text-dark mb-0" style="font-size: 0.95rem;">Per Subject Progress</h6>
                                    <span class="badge bg-light text-muted border small">@card.SubjectProgress.Count subjects</span>
                                </div>

                                <!-- Subject Progress List with Lecture Milestones & Grade/Syllabus -->
                                <div class="subject-progress-list mb-3" id="subjectList_@student.Id" style="max-height: 280px; overflow-y: auto;">
                                    @if (card.SubjectProgress.Any())
                                    {
                                        @for (int sIdx = 0; sIdx < card.SubjectProgress.Count; sIdx++)
                                        {
                                            var sub = card.SubjectProgress[sIdx];
                                            var pct = sub.ProgressPercentage;
                                            <div class="mb-3 p-2 rounded-3 border bg-light-subtle subject-card-item" id="cardSubRow_@(student.Id)_@sIdx">
                                                <div class="d-flex justify-content-between align-items-center small mb-1">
                                                    <div class="d-flex align-items-center gap-1.5 flex-grow-1 me-2 text-truncate">
                                                        <span class="fw-bold text-dark text-truncate" title="@sub.SubjectName">@sub.SubjectName</span>
                                                        <span class="badge @sub.GradeBadgeClass px-1.5 py-0.5 rounded-1 cardSubGradeBadge_@(student.Id)_@sIdx" style="font-size: 0.68rem;" title="Exam Grade: @sub.DisplayGrade">
                                                            @(string.IsNullOrWhiteSpace(sub.Grade) ? "—" : sub.Grade)
                                                        </span>
                                                    </div>
                                                    <span class="text-muted flex-shrink-0" style="font-size: 0.76rem;" id="cardSubDetail_@(student.Id)_@sIdx">
                                                        <strong>@sub.CompletedLectures</strong>/@sub.TotalLectures (<span class="cardSubPct_@(student.Id)_@sIdx">@pct.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)</span>%)
                                                    </span>
                                                </div>
                                                <div class="text-muted mb-1 text-truncate cardSubSyllabus_@(student.Id)_@sIdx @(string.IsNullOrWhiteSpace(sub.Syllabus) ? "d-none" : "")" style="font-size: 0.7rem;" title="Syllabus: @sub.Syllabus">
                                                    <i class="bi bi-journal-text me-1 text-primary"></i><span>@(sub.Syllabus ?? "")</span>
                                                </div>
                                                <div class="progress rounded-pill mb-2" style="height: 6px; background-color: #e2e8f0;">
                                                    <div class="progress-bar rounded-pill @(pct >= 100 ? "bg-success" : (pct > 0 ? "bg-primary" : "bg-light"))" 
                                                         id="cardSubBar_@(student.Id)_@sIdx"
                                                         role="progressbar" 
                                                         style="width: @(pct.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))%;" 
                                                         aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100"></div>
                                                </div>

                                                <!-- Lecture Milestones (Approach A) -->
                                                <div class="d-flex flex-wrap gap-1 align-items-center lecture-badges-container" id="lectureBadges_@(student.Id)_@sIdx" data-student-id="@student.Id" data-student-name="@student.FullName" data-class-level="@(student.ClassLevel?.Replace("Class", "").Trim() ?? "1")" data-subject-name="@sub.SubjectName" data-total-lectures="@sub.TotalLectures" data-sidx="@sIdx">
                                                    @for (int lec = 1; lec <= sub.TotalLectures; lec++)
                                                    {
                                                        var eval = sub.LectureEvaluations?.FirstOrDefault(l => l.LectureNumber == lec);
                                                        if (eval != null)
                                                        {
                                                            var badgeBg = eval.Grade switch {
                                                                "A+" => "background-color: #15803d; color: #fff;",
                                                                "A" => "background-color: #16a34a; color: #fff;",
                                                                "A-" => "background-color: #0284c7; color: #fff;",
                                                                "B" => "background-color: #0d9488; color: #fff;",
                                                                "C" => "background-color: #eab308; color: #000;",
                                                                "D" => "background-color: #f97316; color: #fff;",
                                                                "F" => "background-color: #ef4444; color: #fff;",
                                                                _ => "background-color: #64748b; color: #fff;"
                                                            };
                                                            <button type="button" 
                                                                    class="btn btn-xs rounded-pill px-2 py-0.5 d-inline-flex align-items-center gap-1 border-0 shadow-2xs" 
                                                                    style="@badgeBg font-size: 0.68rem; line-height: 1.1;" 
                                                                    @(!card.IsDeclined ? $"onclick=\"openLectureEvalModal({student.Id}, '{student.FullName.Replace("'", "\\'")}', '{student.ClassLevel?.Replace("Class", "").Trim() ?? "1"}', '{sub.SubjectName.Replace("'", "\\'")}', {lec}, '{eval.Topic.Replace("'", "\\'")}', {(eval.Marks.HasValue ? eval.Marks.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "null")}, '{eval.Grade}', '{(eval.Remarks ?? "").Replace("'", "\\'")}', true, {sIdx})\"" : "disabled")
                                                                    title="Lecture @lec Completed &amp; Evaluated: @eval.Topic | Grade: @eval.Grade | Marks: @(eval.Marks.HasValue ? eval.Marks.Value.ToString() : "N/A") (@(!card.IsDeclined ? "Click to view/edit" : "Declined"))">
                                                                <span>L@(lec): @(string.IsNullOrWhiteSpace(eval.Grade) ? "Done" : eval.Grade)</span>
                                                                <i class="bi bi-check2"></i>
                                                            </button>
                                                        }
                                                        else if (lec == sub.CompletedLectures + 1 && !card.IsDeclined)
                                                        {
                                                            <button type="button" 
                                                                    class="btn btn-xs rounded-pill px-2 py-0.5 btn-outline-primary fw-semibold d-inline-flex align-items-center gap-1" 
                                                                    style="font-size: 0.68rem; line-height: 1.1; border-style: dashed;" 
                                                                    onclick="openLectureEvalModal(@student.Id, '@student.FullName.Replace("'", "\\'")', '@(student.ClassLevel?.Replace("Class", "").Trim() ?? "1")', '@sub.SubjectName.Replace("'", "\\'")', @lec, '', null, 'A+', '', false, @sIdx)"
                                                                    title="Click to evaluate exam &amp; complete Lecture @lec">
                                                                <i class="bi bi-plus-circle-fill text-primary" style="font-size: 0.72rem;"></i>
                                                                <span>L@(lec)</span>
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-light text-muted border rounded-pill px-1.5 py-0.5" 
                                                                  style="font-size: 0.65rem; font-weight: normal; opacity: 0.7;" 
                                                                  title="Lecture @lec (Complete previous lecture first)">
                                                                L@(lec)
                                                            </span>
                                                        }
                                                    }
                                                </div>

                                                <!-- Collapsible Lecture Evaluation History Drawer -->
                                                <div class="mt-1">
                                                    <button class="btn btn-link btn-sm text-decoration-none p-0 text-secondary d-inline-flex align-items-center gap-1" 
                                                            type="button" 
                                                            data-bs-toggle="collapse" 
                                                            data-bs-target="#lecHistory_@(student.Id)_@sIdx" 
                                                            aria-expanded="false" 
                                                            style="font-size: 0.7rem;">
                                                        <i class="bi bi-journal-check text-primary"></i> 
                                                        <span id="lecHistoryToggleText_@(student.Id)_@sIdx">@(sub.LectureEvaluations?.Count ?? 0) lectures evaluated (History)</span>
                                                    </button>
                                                    <div class="collapse mt-1.5" id="lecHistory_@(student.Id)_@sIdx">
                                                        <div class="p-2 rounded-2 bg-white border" style="max-height: 120px; overflow-y: auto;">
                                                            <table class="table table-sm table-borderless align-middle mb-0" style="font-size: 0.7rem;">
                                                                <thead class="text-muted border-bottom">
                                                                    <tr>
                                                                        <th>#</th>
                                                                        <th>Topic</th>
                                                                        <th>Marks</th>
                                                                        <th>Grade</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody id="lecHistoryTableBody_@(student.Id)_@sIdx">
                                                                    @if (sub.LectureEvaluations != null && sub.LectureEvaluations.Any())
                                                                    {
                                                                        @foreach (var eval in sub.LectureEvaluations.OrderBy(l => l.LectureNumber))
                                                                        {
                                                                            <tr>
                                                                                <td><span class="badge bg-secondary-subtle text-secondary rounded-pill">L@(eval.LectureNumber)</span></td>
                                                                                <td class="text-truncate" style="max-width: 100px;" title="@eval.Topic">@eval.Topic</td>
                                                                                <td>@(eval.Marks.HasValue ? eval.Marks.Value.ToString() : "—")</td>
                                                                                <td><span class="badge @(SubjectProgressItem.GradeToPoint(eval.Grade) >= 4.0 ? "bg-success" : (SubjectProgressItem.GradeToPoint(eval.Grade) >= 3.0 ? "bg-primary" : "bg-warning text-dark")) px-1 py-0.5 rounded-1">@eval.Grade</span></td>
                                                                            </tr>
                                                                        }
                                                                    }
                                                                    else
                                                                    {
                                                                        <tr>
                                                                            <td colspan="4" class="text-muted text-center fst-italic py-1">No lectures evaluated yet.</td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="text-muted small py-2 text-center fst-italic">No curriculum subjects registered yet.</div>
                                    }
                                </div>

                                <div style="height: 140px;" class="position-relative">
                                    <canvas id="@barId"></canvas>
                                </div>
                            </div>

                            <!-- Action Buttons -->
                            <div class="mt-auto d-flex flex-column gap-2 mb-3">
                                @if (card.IsDeclined)
                                {
                                    <!-- Declined: Progress Cannot Be Updated -->
                                    <button type="button" 
                                            class="btn w-100 fw-medium py-2 rounded-2 shadow-sm text-secondary bg-light border text-center" 
                                            style="font-size: 0.82rem; cursor: not-allowed;" 
                                            disabled
                                            title="Student enrollment was declined. Progress cannot be updated.">
                                        <i class="bi bi-slash-circle me-1 text-danger"></i> Enrollment Declined (Cannot Update Progress)
                                    </button>

                                    <!-- Declined: Exam Evaluation Cannot Be Updated -->
                                    <button type="button" 
                                            class="btn w-100 fw-medium py-2 rounded-2 border text-muted bg-light text-center" 
                                            style="font-size: 0.82rem; cursor: not-allowed;" 
                                            disabled
                                            title="Student enrollment was declined. Exam evaluation cannot be updated.">
                                        <i class="bi bi-slash-circle me-1 text-danger"></i> Exam Evaluation Unavailable (Declined)
                                    </button>

                                    <!-- Declined: Promotion Not Available -->
                                    <button type="button" 
                                            class="btn btn-light w-100 fw-medium py-2 rounded-2 border text-muted text-center" 
                                            style="font-size: 0.82rem; cursor: not-allowed;" 
                                            disabled
                                            title="Student enrollment was declined. Promotion is not available.">
                                        <i class="bi bi-x-octagon me-1 text-danger"></i> Promotion Unavailable (Declined)
                                    </button>
                                }
                                else
                                {
                                    <div class="row g-2">
                                        <div class="col-6">
                                            <!-- Update Lecture Progress Button (Yellow/Amber) -->
                                            <button type="button" 
                                                    class="btn w-100 fw-bold py-2 rounded-2 shadow-sm text-white btn-update-progress" 
                                                    style="background-color: #f59e0b; border: none; font-size: 0.82rem;"
                                                    data-bs-toggle="modal" 
                                                    data-bs-target="#updateProgressModal-@student.Id">
                                                <i class="bi bi-sliders me-1"></i> Lectures
                                            </button>
                                        </div>
                                        <div class="col-6">
                                            <!-- Exam Evaluation Button (Indigo) -->
                                            <button type="button" 
                                                    class="btn w-100 fw-bold py-2 rounded-2 shadow-sm text-white btn-exam-evaluation" 
                                                    style="background-color: #6366f1; border: none; font-size: 0.82rem;"
                                                    data-bs-toggle="modal" 
                                                    data-bs-target="#examEvaluationModal-@student.Id">
                                                <i class="bi bi-award me-1"></i> Exam Eval
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Promotion requires completion plus recorded passing assessment in each subject -->
                                    @if (card.CanPromote)
                                    {
                                        <form asp-action="PromoteStudent" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@student.Id" />
                                            <button type="submit" class="btn btn-success w-100 fw-bold py-2 rounded-2 shadow-sm d-inline-flex align-items-center justify-content-center gap-1.5" style="font-size: 0.85rem;" onclick="return confirm('Promote @student.FullName to Class @card.NextClassLevel?');">
                                                <i class="bi bi-mortarboard-fill"></i>
                                                <span>Promote to Class @card.NextClassLevel</span>
                                            </button>
                                        </form>
                                    }
                                    else if (card.OverallProgressPercent >= 100.0 && !card.HasPassingAssessment)
                                    {
                                        <button type="button" class="btn btn-outline-warning w-100 fw-medium py-2 rounded-2" disabled title="A passing assessment is required in every subject">
                                            Record a passing assessment in every subject to enable promotion
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" 
                                                class="btn btn-primary w-100 fw-medium py-2 rounded-2 shadow-sm text-center" 
                                                style="background-color: #0d6efd; border: none; font-size: 0.82rem; cursor: not-allowed; opacity: 0.95;"
                                                title="Complete all planned lectures across all subjects">
                                            Complete all planned lectures to enable promotion
                                        </button>
                                    }
                                }
                            </div>

                            <!-- Card Footer -->
                            <div class="pt-2 border-top d-flex justify-content-between align-items-center text-muted small" style="font-size: 0.8rem;">
                                <div>
                                    Status: 
                                    @if (card.StatusDisplay == "verified")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-0.5" style="font-size: 0.75rem;">verified</span>
                                    }
                                    else if (card.StatusDisplay == "declined")
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2 py-0.5" style="font-size: 0.75rem;">declined</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-2 py-0.5" style="font-size: 0.75rem;">pending</span>
                                    }
                                </div>

                                <div class="text-truncate" style="max-width: 150px;" title="@student.FatherName">
                                    Father: @(string.IsNullOrWhiteSpace(student.FatherName) ? "N/A" : student.FatherName)
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (!card.IsDeclined)
                    {
                        <!-- Modal for Updating Progress for this Student -->
                        <div class="modal fade" id="updateProgressModal-@student.Id" tabindex="-1" aria-labelledby="modalLabel-@student.Id" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered modal-lg">
                                <div class="modal-content rounded-4 border-0 shadow">
                                    <div class="modal-header bg-light border-bottom-0 rounded-top-4 pb-3">
                                        <div>
                                            <h5 class="modal-title fw-bold text-dark mb-0" id="modalLabel-@student.Id">
                                                Update Learning Progress: @student.FullName
                                            </h5>
                                            <span class="text-muted small">
                                                Class @student.ClassLevel | Birth Cert ID: @(student.BirthCertificateId ?? "N/A") | Enrollment: @(student.EnrollmentYear ?? "2025")
                                            </span>
                                        </div>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>

                                    <form id="progressForm_@student.Id" onsubmit="submitProgressUpdate(event, @student.Id)">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="StudentId" value="@student.Id" />

                                        <div class="modal-body p-4">
                                            <div class="alert alert-info border-0 rounded-3 d-flex align-items-center gap-2 p-2.5 mb-3 small" style="background-color: #f0fdf4; color: #166534;">
                                                <i class="bi bi-info-circle-fill text-success fs-5"></i>
                                                <span>
                                                    Each class curriculum is configured via <strong>ClassPlan</strong> in the database. Update the completed lectures for each subject below.
                                                </span>
                                            </div>

                                            <h6 class="fw-bold text-dark mb-3">Subjects & Lecture Completion</h6>

                                            <div class="row g-3 mb-4">
                                                @for (int sIdx = 0; sIdx < card.SubjectProgress.Count; sIdx++)
                                                {
                                                    var sub = card.SubjectProgress[sIdx];
                                                    var subPercent = sub.ProgressPercentage;

                                                    <div class="col-md-6">
                                                        <div class="p-3 bg-light rounded-3 border subject-input-row" data-total="@sub.TotalLectures">
                                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                                <strong class="text-dark small text-truncate" style="max-width: 170px;" title="@sub.SubjectName">
                                                                    @sub.SubjectName
                                                                </strong>
                                                                <span class="badge bg-secondary-subtle text-secondary rounded-pill small">
                                                                    @sub.TotalLectures Total Lectures
                                                                </span>
                                                            </div>

                                                            <input type="hidden" name="SubjectProgress[@sIdx].SubjectName" value="@sub.SubjectName" />
                                                            <input type="hidden" name="SubjectProgress[@sIdx].TotalLectures" value="@sub.TotalLectures" />

                                                            <div class="d-flex align-items-center gap-2 mb-2">
                                                                <label class="text-muted small mb-0 flex-shrink-0">Completed:</label>
                                                                <div class="input-group input-group-sm">
                                                                    <button type="button" class="btn btn-outline-secondary px-2.5" onclick="stepLectureInput(@student.Id, @sIdx, -1)">-</button>
                                                                    <input type="number" 
                                                                           id="completedInput_@(student.Id)_@sIdx"
                                                                           name="SubjectProgress[@sIdx].CompletedLectures" 
                                                                           value="@sub.CompletedLectures" 
                                                                           min="0" 
                                                                           max="@sub.TotalLectures" 
                                                                           class="form-control text-center fw-bold" 
                                                                           oninput="updateSubjectBarPreview(@student.Id, @sIdx, @sub.TotalLectures)" />
                                                                    <button type="button" class="btn btn-outline-secondary px-2.5" onclick="stepLectureInput(@student.Id, @sIdx, 1)">+</button>
                                                                </div>
                                                                <span class="small fw-semibold text-primary flex-shrink-0" id="subPercentBadge_@(student.Id)_@sIdx" style="min-width: 45px; text-align: right;">
                                                                    @subPercent.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%
                                                                </span>
                                                            </div>

                                                            <!-- Live Mini Progress Bar -->
                                                            <div class="progress" style="height: 6px;">
                                                                <div class="progress-bar bg-success" 
                                                                     id="subProgressBar_@(student.Id)_@sIdx"
                                                                     role="progressbar" 
                                                                     style="width: @subPercent%;" 
                                                                     aria-valuenow="@subPercent" 
                                                                     aria-valuemin="0" 
                                                                     aria-valuemax="100"></div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>

                                            <div class="row g-3">
                                                <div class="col-md-5">
                                                    <label class="form-label fw-semibold small text-dark">Attendance Percentage (%)</label>
                                                    <div class="input-group input-group-sm">
                                                        <input type="number" name="AttendancePercentage" value="@student.AttendancePercentage" min="0" max="100" class="form-control rounded-3" />
                                                        <span class="input-group-text">%</span>
                                                    </div>
                                                </div>

                                                <div class="col-md-7">
                                                    <label class="form-label fw-semibold small text-dark">Guardian Notes / Assessment</label>
                                                    <input type="text" name="Notes" value="@student.Notes" placeholder="e.g. Regular study, showing strong improvement" class="form-control form-control-sm rounded-3" />
                                                </div>
                                            </div>
                                        </div>

                                        <div class="modal-footer bg-light border-top-0 rounded-bottom-4 pt-0">
                                            <button type="button" class="btn btn-secondary rounded-pill px-3.5 btn-sm" data-bs-dismiss="modal">Cancel</button>
                                            <button type="submit" id="saveProgressBtn_@student.Id" class="btn btn-primary rounded-pill px-4 btn-sm fw-bold d-inline-flex align-items-center gap-1.5">
                                                <i class="bi bi-check2-circle"></i>
                                                <span>Save Progress</span>
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>

                        <!-- Modal for Exam Evaluation for this Student -->
                        <div class="modal fade" id="examEvaluationModal-@student.Id" tabindex="-1" aria-labelledby="examModalLabel-@student.Id" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered modal-lg">
                                <div class="modal-content rounded-4 border-0 shadow">
                                    <div class="modal-header bg-light border-bottom-0 rounded-top-4 pb-3">
                                        <div>
                                            <h5 class="modal-title fw-bold text-dark mb-0 d-flex align-items-center gap-2" id="examModalLabel-@student.Id">
                                                <i class="bi bi-award-fill" style="color: #6366f1;"></i>
                                                <span>Exam Evaluation &amp; Grade: @student.FullName</span>
                                            </h5>
                                            <span class="text-muted small">
                                                Class @(student.ClassLevel?.Replace("Class", "").Trim() ?? "1") | Birth Cert ID: @(student.BirthCertificateId ?? "N/A") | Enrollment: @(student.EnrollmentYear ?? "2025")
                                            </span>
                                        </div>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>

                                    <form id="examForm_@student.Id" onsubmit="submitExamEvaluation(event, @student.Id)">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="StudentId" value="@student.Id" />

                                        <div class="modal-body p-4">
                                            <div class="alert alert-primary border-0 rounded-3 d-flex align-items-center gap-2 p-2.5 mb-3 small" style="background-color: #eef2ff; color: #3730a3;">
                                                <i class="bi bi-info-circle-fill fs-5" style="color: #6366f1;"></i>
                                                <span>
                                                    Syllabus / Topics Covered are <strong>automatically filled</strong> with completed lecture numbers. Please enter the <strong>Grade</strong> (or Marks) for each completed lecture series.
                                                </span>
                                            </div>

                                            <div class="d-flex justify-content-between align-items-center mb-3">
                                                <h6 class="fw-bold text-dark mb-0">Subject Syllabus &amp; Grades</h6>
                                                <span class="small text-muted fst-italic">Standard Grading: A+ (5.0), A (4.0), A- (3.5), B (3.0), C (2.0), D (1.0), F (0.0)</span>
                                            </div>

                                            <div class="table-responsive mb-3">
                                                <table class="table table-sm table-bordered align-middle mb-0 rounded-3 overflow-hidden">
                                                    <thead class="table-light text-muted small">
                                                        <tr>
                                                            <th style="width: 25%;">Subject</th>
                                                            <th style="width: 45%;">Syllabus / Topics Covered (Auto-filled)</th>
                                                            <th style="width: 15%;">Marks (0-100)</th>
                                                            <th style="width: 15%;">Grade</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @for (int sIdx = 0; sIdx < card.SubjectProgress.Count; sIdx++)
                                                        {
                                                            var sub = card.SubjectProgress[sIdx];
                                                            var sylVal = !string.IsNullOrWhiteSpace(sub.Syllabus) 
                                                                ? sub.Syllabus 
                                                                : (sub.CompletedLectures > 0 
                                                                    ? (sub.CompletedLectures == 1 ? "Lecture 1" : $"Lectures 1 to {sub.CompletedLectures}") 
                                                                    : "No lectures completed");
                                                            <tr>
                                                                <td>
                                                                    <div class="d-flex flex-column">
                                                                        <strong class="text-dark small">@sub.SubjectName</strong>
                                                                        <span class="text-muted" style="font-size: 0.72rem;" id="examLecCount_@(student.Id)_@sIdx">
                                                                            @(sub.CompletedLectures) of @(sub.TotalLectures) lectures completed
                                                                        </span>
                                                                    </div>
                                                                    <input type="hidden" name="Evaluations[@sIdx].SubjectName" value="@sub.SubjectName" />
                                                                </td>
                                                                <td>
                                                                    <div class="input-group input-group-sm">
                                                                        <span class="input-group-text bg-light text-primary border-end-0 py-1" style="font-size: 0.78rem;" title="Covered lecture syllabus">
                                                                            <i class="bi bi-journal-bookmark-fill"></i>
                                                                        </span>
                                                                        <input type="text" 
                                                                               id="examSyllabus_@(student.Id)_@sIdx"
                                                                               name="Evaluations[@sIdx].Syllabus" 
                                                                               value="@sylVal" 
                                                                               class="form-control form-control-sm border-start-0 ps-1 bg-light fw-medium text-secondary" 
                                                                               placeholder="e.g. Lectures 1 to @sub.CompletedLectures" />
                                                                    </div>
                                                                </td>
                                                                <td>
                                                                    <input type="number" 
                                                                           min="0" 
                                                                           max="100" 
                                                                           step="0.5"
                                                                           id="examMarks_@(student.Id)_@sIdx"
                                                                           name="Evaluations[@sIdx].Marks" 
                                                                           value="@(sub.Marks.HasValue ? sub.Marks.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) : "")" 
                                                                           class="form-control form-control-sm text-center" 
                                                                           placeholder="Marks"
                                                                           oninput="autoSelectGradeFromMarks(@student.Id, @sIdx, this.value)" />
                                                                </td>
                                                                <td>
                                                                    <select name="Evaluations[@sIdx].Grade" 
                                                                            id="examGrade_@(student.Id)_@sIdx" 
                                                                            class="form-select form-select-sm fw-semibold border-primary shadow-sm">
                                                                        <option value="" selected="@(string.IsNullOrWhiteSpace(sub.Grade))">-- Grade --</option>
                                                                        <option value="A+" selected="@(sub.Grade == "A+")">A+ (5.0)</option>
                                                                        <option value="A" selected="@(sub.Grade == "A")">A (4.0)</option>
                                                                        <option value="A-" selected="@(sub.Grade == "A-")">A- (3.5)</option>
                                                                        <option value="B" selected="@(sub.Grade == "B")">B (3.0)</option>
                                                                        <option value="C" selected="@(sub.Grade == "C")">C (2.0)</option>
                                                                        <option value="D" selected="@(sub.Grade == "D")">D (1.0)</option>
                                                                        <option value="F" selected="@(sub.Grade == "F")">F (0.0)</option>
                                                                    </select>
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>

                                            <div>
                                                <label class="form-label fw-semibold small text-dark mb-1">Guardian Exam Remarks / Assessment</label>
                                                <input type="text" name="Remarks" value="@student.Notes" placeholder="e.g. Term exam completed with solid overall understanding" class="form-control form-control-sm rounded-3" />
                                            </div>
                                        </div>

                                        <div class="modal-footer bg-light border-top-0 rounded-bottom-4 pt-0">
                                            <button type="button" class="btn btn-secondary rounded-pill px-3.5 btn-sm" data-bs-dismiss="modal">Cancel</button>
                                            <button type="submit" id="saveExamBtn_@student.Id" class="btn rounded-pill px-4 btn-sm fw-bold text-white d-inline-flex align-items-center gap-1.5" style="background-color: #6366f1;">
                                                <i class="bi bi-check2-circle"></i>
                                                <span>Save Exam Evaluation</span>
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        }
    </div>
</div>

<section class="card border-0 shadow-sm rounded-4 p-3 p-md-4 mb-4 bg-white">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
            <h4 class="fw-bold mb-1"><i class="bi bi-clock-history text-primary me-1"></i>Recent Progress Updates</h4>
            <p class="text-muted small mb-0">Shows who changed progress and when. Volunteer notes themselves are not stored in this history.</p>
        </div>
    </div>
    @if (Model.RecentChanges.Count == 0)
    {
        <div class="text-muted small">No progress updates have been recorded yet.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead><tr><th>Student</th><th>Update</th><th>Changed by</th><th>Role</th><th>Date</th></tr></thead>
                <tbody>
                    @foreach (var change in Model.RecentChanges)
                    {
                        <tr>
                            <td class="fw-semibold">@change.Student.FullName</td>
                            <td>@change.Summary</td>
                            <td>@change.ChangedBy</td>
                            <td><span class="badge bg-light text-dark border">@change.ChangedByRole</span></td>
                            <td class="text-nowrap">@change.CreatedAt.ToString("dd MMM yyyy, h:mm tt 'UTC'")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<div class="modal fade" id="aiProgressModal" tabindex="-1" aria-labelledby="aiProgressModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title fw-bold" id="aiProgressModalTitle"><i class="bi bi-stars text-primary me-1"></i>AI Progress Assistant</h5>
                    <div class="small text-muted" id="aiProgressStudentName"></div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="aiProgressStudentId" />
                <label for="aiProgressNote" class="form-label fw-semibold">Volunteer progress note</label>
                <textarea id="aiProgressNote" class="form-control" rows="4" maxlength="2000" placeholder="Example: Rafi completed Math lectures 1-3 on fractions. He scored 82 marks (A-) on lecture 3."></textarea>
                <div class="form-text">AI prepares a draft for this student. Review each lecture, mark, and grade before saving. A blank grade records completion only.</div>
                <div id="aiProgressMessage" class="small mt-2" role="status"></div>
                <div id="aiProgressDraftWrap" class="mt-3 d-none">
                    <h6 class="fw-bold">Review suggested updates</h6>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead><tr><th>Subject</th><th>Lecture</th><th>Topic</th><th>Marks</th><th>Grade</th></tr></thead>
                            <tbody id="aiProgressDraftRows"></tbody>
                        </table>
                    </div>
                    <div id="aiProgressClarifications" class="alert alert-warning py-2 d-none"></div>
                </div>
            </div>
            <div class="modal-footer">
                @Html.AntiForgeryToken()
                <button type="button" class="btn btn-outline-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="aiProgressAnalyzeBtn" class="btn btn-outline-primary rounded-pill" onclick="analyzeAiProgressNote()"><i class="bi bi-stars me-1"></i>Analyze note</button>
                <button type="button" id="aiProgressApplyBtn" class="btn btn-primary rounded-pill d-none" onclick="applyAiProgressDraft()">Review and save</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="aiSummaryModal" tabindex="-1" aria-labelledby="aiSummaryTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header"><div><h5 class="modal-title fw-bold" id="aiSummaryTitle"><i class="bi bi-lightbulb text-success me-1"></i>AI Learning Summary</h5><div class="small text-muted" id="aiSummaryStudent"></div></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
            <div class="modal-body"><div id="aiSummaryBody" class="small" aria-live="polite" style="white-space: pre-line;">Preparing summary…</div><div class="text-muted small mt-3">Based on recorded progress only. Use volunteer judgment for learning or promotion decisions.</div></div>
            <div class="modal-footer"><button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Close</button></div>
            @Html.AntiForgeryToken()
        </div>
    </div>
</div>

<!-- Modal for Lecture-by-Lecture Exam Evaluation (Approach A) -->
<div class="modal fade" id="singleLectureEvalModal" tabindex="-1" aria-labelledby="singleLecModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-light border-bottom-0 rounded-top-4 pb-2">
                <div>
                    <h5 class="modal-title fw-bold text-dark mb-0 d-flex align-items-center gap-2" id="singleLecModalLabel">
                        <i class="bi bi-award-fill text-primary"></i>
                        <span id="singleLecModalTitle">Evaluate Lecture Exam</span>
                    </h5>
                    <span class="text-muted small" id="singleLecModalSubTitle">
                        Student | Subject | Lecture #
                    </span>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form id="singleLectureEvalForm" onsubmit="submitLectureEvaluation(event)">
                @Html.AntiForgeryToken()
                <input type="hidden" id="lecModalStudentId" name="StudentId" value="" />
                <input type="hidden" id="lecModalSubjectName" name="SubjectName" value="" />
                <input type="hidden" id="lecModalLectureNumber" name="LectureNumber" value="" />
                <input type="hidden" id="lecModalIsDelete" name="IsDelete" value="false" />
                <input type="hidden" id="lecModalSIdx" value="0" />

                <div class="modal-body p-4">
                    <div class="alert alert-primary border-0 rounded-3 d-flex align-items-center gap-2 p-2.5 mb-3 small" style="background-color: #eff6ff; color: #1e40af;">
                        <i class="bi bi-info-circle-fill fs-5 text-primary"></i>
                        <span>
                            To complete this lecture milestone, evaluate the student's exam/quiz below. Progress and grade points update automatically.
                        </span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-dark mb-1">Lecture Topic / Syllabus Covered <span class="text-danger">*</span></label>
                        <input type="text" 
                               id="lecModalTopic" 
                               class="form-control rounded-3" 
                               placeholder="e.g. Chapter 4: Quadratic Equations &amp; Formulas" 
                               required />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold small text-dark mb-1">Exam Marks (0 - 100)</label>
                            <input type="number" 
                                   id="lecModalMarks" 
                                   min="0" 
                                   max="100" 
                                   step="0.5" 
                                   class="form-control rounded-3 text-center fw-bold" 
                                   placeholder="e.g. 85" 
                                   oninput="autoSelectLecGrade(this.value)" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold small text-dark mb-1">Grade Awarded <span class="text-danger">*</span></label>
                            <select id="lecModalGrade" class="form-select rounded-3 fw-bold">
                                <option value="A+">A+ (5.0 GPA | 80-100%)</option>
                                <option value="A">A (4.0 GPA | 70-79%)</option>
                                <option value="A-">A- (3.5 GPA | 60-69%)</option>
                                <option value="B">B (3.0 GPA | 50-59%)</option>
                                <option value="C">C (2.0 GPA | 40-49%)</option>
                                <option value="D">D (1.0 GPA | 33-39%)</option>
                                <option value="F">F (0.0 GPA | &lt;33%)</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label fw-semibold small text-dark mb-1">Guardian Remarks (Optional)</label>
                        <textarea id="lecModalRemarks" class="form-control rounded-3" rows="2" placeholder="e.g. Understood chapter concepts well, strong performance in exercises"></textarea>
                    </div>
                </div>

                <div class="modal-footer bg-light border-top-0 rounded-bottom-4 pt-0 d-flex justify-content-between">
                    <div>
                        <button type="button" 
                                id="lecModalRevertBtn" 
                                class="btn btn-outline-danger rounded-pill px-3 btn-sm d-none" 
                                onclick="revertLectureCompletion()">
                            <i class="bi bi-trash3 me-1"></i> Revert Completion
                        </button>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-secondary rounded-pill px-3 btn-sm" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" id="lecModalSaveBtn" class="btn btn-primary rounded-pill px-4 btn-sm fw-bold d-inline-flex align-items-center gap-1.5">
                            <i class="bi bi-check2-circle"></i>
                            <span id="lecModalSaveBtnText">Save &amp; Complete Lecture</span>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Load Chart.js from CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

    <script>
        const studentCharts = {};
        let aiProgressDraft = [];

        async function getAiLearningSummary(studentId) {
            const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('aiSummaryModal'));
            const body = document.getElementById('aiSummaryBody');
            const name = document.getElementById('aiSummaryStudent');
            body.textContent = 'Preparing summary from recorded progress…';
            name.textContent = '';
            modal.show();
            try {
                const token = document.querySelector('#aiSummaryModal input[name="__RequestVerificationToken"]')?.value;
                const response = await fetch('/Student/GetAiLearningSummary', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                    body: JSON.stringify({ studentId })
                });
                const data = await response.json();
                if (!response.ok || !data.success) throw new Error(data.message || 'Could not prepare the summary.');
                name.textContent = data.studentName;
                body.textContent = data.summary;
            } catch (error) { body.textContent = error.message || 'AI could not prepare the summary. Please try again.'; }
        }

        function openAiProgressModal(studentId, studentName) {
            document.getElementById('aiProgressStudentId').value = studentId;
            document.getElementById('aiProgressStudentName').textContent = studentName;
            document.getElementById('aiProgressNote').value = '';
            document.getElementById('aiProgressMessage').textContent = '';
            document.getElementById('aiProgressDraftWrap').classList.add('d-none');
            document.getElementById('aiProgressApplyBtn').classList.add('d-none');
            aiProgressDraft = [];
            bootstrap.Modal.getOrCreateInstance(document.getElementById('aiProgressModal')).show();
        }

        async function analyzeAiProgressNote() {
            const button = document.getElementById('aiProgressAnalyzeBtn');
            const message = document.getElementById('aiProgressMessage');
            const note = document.getElementById('aiProgressNote').value.trim();
            if (!note) { message.textContent = 'Write the volunteer progress note first.'; return; }
            button.disabled = true;
            message.textContent = 'AI is organizing the note…';
            try {
                const token = document.querySelector('#aiProgressModal input[name="__RequestVerificationToken"]')?.value;
                const response = await fetch('/Student/AnalyzeProgressNote', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                    body: JSON.stringify({ studentId: Number(document.getElementById('aiProgressStudentId').value), note })
                });
                const data = await response.json();
                if (!response.ok || !data.success) throw new Error(data.message || 'Could not analyze the note.');
                aiProgressDraft = data.items || [];
                renderAiProgressDraft(data.needsClarification || []);
                message.textContent = aiProgressDraft.length ? 'Draft ready. Review or edit it before saving.' : 'No safe progress update could be extracted. Clarify the subject, completed lectures, or grade in the note.';
            } catch (error) {
                message.textContent = error.message || 'AI could not analyze the note. Please try again.';
            } finally { button.disabled = false; }
        }

        function renderAiProgressDraft(clarifications) {
            const body = document.getElementById('aiProgressDraftRows');
            body.replaceChildren();
            const grades = ['', 'A+', 'A', 'A-', 'B', 'C', 'D', 'F'];
            aiProgressDraft.forEach((item, index) => {
                const row = document.createElement('tr');
                row.dataset.index = index;
                const subject = document.createElement('td'); subject.textContent = item.subjectName;
                const lectureCell = document.createElement('td');
                const lecture = document.createElement('input'); lecture.type = 'number'; lecture.min = '1'; lecture.max = '100'; lecture.value = item.lectureNumber; lecture.className = 'form-control form-control-sm ai-draft-lecture'; lecture.style.width = '76px'; lectureCell.append(lecture);
                const topicCell = document.createElement('td');
                const topic = document.createElement('input'); topic.type = 'text'; topic.maxLength = 200; topic.value = item.topic || ''; topic.className = 'form-control form-control-sm ai-draft-topic'; topicCell.append(topic);
                const marksCell = document.createElement('td');
                const marks = document.createElement('input'); marks.type = 'number'; marks.min = '0'; marks.max = '100'; marks.step = '0.5'; marks.value = item.marks ?? ''; marks.className = 'form-control form-control-sm ai-draft-marks'; marks.style.width = '82px'; marksCell.append(marks);
                const gradeCell = document.createElement('td');
                const grade = document.createElement('select'); grade.className = 'form-select form-select-sm ai-draft-grade';
                grades.forEach(value => { const option = document.createElement('option'); option.value = value; option.textContent = value || '—'; grade.append(option); });
                grade.value = item.grade || ''; gradeCell.append(grade);
                row.append(subject, lectureCell, topicCell, marksCell, gradeCell); body.append(row);
            });
            const warning = document.getElementById('aiProgressClarifications');
            warning.textContent = (clarifications || []).join(' ');
            warning.classList.toggle('d-none', !clarifications?.length);
            document.getElementById('aiProgressDraftWrap').classList.toggle('d-none', !aiProgressDraft.length && !clarifications?.length);
            document.getElementById('aiProgressApplyBtn').classList.toggle('d-none', !aiProgressDraft.length);
        }

        async function applyAiProgressDraft() {
            const rows = [...document.querySelectorAll('#aiProgressDraftRows tr')];
            const items = rows.map((row, index) => ({
                ...aiProgressDraft[index],
                lectureNumber: Number(row.querySelector('.ai-draft-lecture').value),
                topic: row.querySelector('.ai-draft-topic').value.trim(),
                marks: row.querySelector('.ai-draft-marks').value === '' ? null : Number(row.querySelector('.ai-draft-marks').value),
                grade: row.querySelector('.ai-draft-grade').value || null
            }));
            if (!items.length) return;
            const button = document.getElementById('aiProgressApplyBtn');
            const message = document.getElementById('aiProgressMessage');
            if (!confirm('Save these reviewed lecture completions and grades to this student\'s progress?')) return;
            button.disabled = true;
            try {
                const token = document.querySelector('#aiProgressModal input[name="__RequestVerificationToken"]')?.value;
                const response = await fetch('/Student/ApplyAiProgressDraft', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                    body: JSON.stringify({ studentId: Number(document.getElementById('aiProgressStudentId').value), items })
                });
                const data = await response.json();
                if (!response.ok || !data.success) throw new Error(data.message || 'Could not save the reviewed draft.');
                message.textContent = data.message;
                window.location.reload();
            } catch (error) {
                message.textContent = error.message || 'Could not save the draft.';
                button.disabled = false;
            }
        }

        // Subject labels & completion percentages per student
        const studentDataMap = {
            @foreach (var card in Model.Cards)
            {
                var student = card.Student;
                var subjectsJson = System.Text.Json.JsonSerializer.Serialize(card.SubjectProgress.Select(s => s.SubjectName).ToList());
                var percentagesJson = System.Text.Json.JsonSerializer.Serialize(card.SubjectProgress.Select(s => s.ProgressPercentage).ToList());
                var completedLecturesJson = System.Text.Json.JsonSerializer.Serialize(card.SubjectProgress.Select(s => s.CompletedLectures).ToList());
                var totalLecturesJson = System.Text.Json.JsonSerializer.Serialize(card.SubjectProgress.Select(s => s.TotalLectures).ToList());
                var overallVal = card.OverallProgressPercent.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);
                <text>
                "@student.Id": {
                    overall: @overallVal,
                    subjects: @Html.Raw(subjectsJson),
                    percentages: @Html.Raw(percentagesJson),
                    completed: @Html.Raw(completedLecturesJson),
                    totals: @Html.Raw(totalLecturesJson)
                },
                </text>
            }
        };

        document.addEventListener('DOMContentLoaded', function () {
            // Initialize charts for each student
            Object.keys(studentDataMap).forEach(studentId => {
                initStudentCharts(studentId);
            });
        });

        function initStudentCharts(studentId) {
            const data = studentDataMap[studentId];
            if (!data) return;

            // 1. Initialize Overall Progress Donut Chart
            const donutCtx = document.getElementById('donutChart_' + studentId);
            if (donutCtx) {
                const completedVal = data.overall;
                const remainingVal = Math.max(0, 100 - completedVal);

                if (studentCharts['donut_' + studentId]) {
                    studentCharts['donut_' + studentId].destroy();
                }

                studentCharts['donut_' + studentId] = new Chart(donutCtx, {
                    type: 'doughnut',
                    data: {
                        labels: ['Completed', 'Remaining'],
                        datasets: [{
                            data: [completedVal, remainingVal],
                            backgroundColor: ['#38bdf8', '#e2e8f0'],
                            borderWidth: 0,
                            hoverOffset: 2
                        }]
                    },
                    options: {
                        cutout: '75%',
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function (ctx) {
                                        return ' ' + ctx.label + ': ' + ctx.parsed.toFixed(1) + '%';
                                    }
                                }
                            }
                        }
                    }
                });
            }

            // 2. Initialize Per Subject Progress Bar Chart (Horizontal for clean readable labels)
            const barCtx = document.getElementById('barChart_' + studentId);
            if (barCtx) {
                if (studentCharts['bar_' + studentId]) {
                    studentCharts['bar_' + studentId].destroy();
                }

                studentCharts['bar_' + studentId] = new Chart(barCtx, {
                    type: 'bar',
                    data: {
                        labels: data.subjects,
                        datasets: [{
                            label: 'Completion %',
                            data: data.percentages,
                            backgroundColor: '#22c55e',
                            borderRadius: 3,
                            barPercentage: 0.6,
                            categoryPercentage: 0.85
                        }]
                    },
                    options: {
                        indexAxis: 'y',
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function (ctx) {
                                        const idx = ctx.dataIndex;
                                        const comp = data.completed[idx] || 0;
                                        const tot = data.totals[idx] || 0;
                                        return ' ' + ctx.parsed.x.toFixed(1) + '% (' + comp + '/' + tot + ' lectures)';
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                min: 0,
                                max: 100,
                                ticks: {
                                    stepSize: 25,
                                    font: { size: 9 },
                                    color: '#64748b',
                                    callback: function (v) { return v + '%'; }
                                },
                                grid: {
                                    color: '#f1f5f9'
                                }
                            },
                            y: {
                                ticks: {
                                    font: { size: 9 },
                                    color: '#334155'
                                },
                                grid: { display: false }
                            }
                        }
                    }
                });
            }
        }

        // Stepper for Lecture Input in Modal
        function stepLectureInput(studentId, sIdx, step) {
            const input = document.getElementById('completedInput_' + studentId + '_' + sIdx);
            if (!input) return;
            const cur = parseInt(input.value) || 0;
            const min = parseInt(input.min) || 0;
            const max = parseInt(input.max) || 12;
            const nextVal = Math.min(Math.max(cur + step, min), max);
            input.value = nextVal;
            updateSubjectBarPreview(studentId, sIdx, max);
        }

        // Live preview of bar & badge percentage when typing in modal
        function updateSubjectBarPreview(studentId, sIdx, totalLectures) {
            const input = document.getElementById('completedInput_' + studentId + '_' + sIdx);
            const badge = document.getElementById('subPercentBadge_' + studentId + '_' + sIdx);
            const pBar = document.getElementById('subProgressBar_' + studentId + '_' + sIdx);
            if (!input) return;

            let completed = parseInt(input.value) || 0;
            if (completed < 0) completed = 0;
            if (completed > totalLectures) completed = totalLectures;
            input.value = completed;

            const pct = totalLectures > 0 ? ((completed / totalLectures) * 100).toFixed(1) : 0;
            if (badge) badge.textContent = pct + '%';
            if (pBar) {
                pBar.style.width = pct + '%';
                pBar.setAttribute('aria-valuenow', pct);
            }
        }

        // Handle AJAX Submit of Progress Update
        function submitProgressUpdate(event, studentId) {
            event.preventDefault();
            const form = document.getElementById('progressForm_' + studentId);
            const saveBtn = document.getElementById('saveProgressBtn_' + studentId);
            if (!form || !saveBtn) return;

            const formData = new FormData(form);
            const subjectProgress = [];

            let sIdx = 0;
            while (formData.has(`SubjectProgress[${sIdx}].SubjectName`)) {
                subjectProgress.push({
                    SubjectName: formData.get(`SubjectProgress[${sIdx}].SubjectName`),
                    TotalLectures: parseInt(formData.get(`SubjectProgress[${sIdx}].TotalLectures`)) || 12,
                    CompletedLectures: parseInt(formData.get(`SubjectProgress[${sIdx}].CompletedLectures`)) || 0
                });
                sIdx++;
            }

            const payload = {
                StudentId: studentId,
                AttendancePercentage: parseInt(formData.get('AttendancePercentage')) || 90,
                Notes: formData.get('Notes') || '',
                SubjectProgress: subjectProgress
            };

            const token = form.querySelector('input[name="__RequestVerificationToken"]')?.value;

            saveBtn.disabled = true;
            saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Saving...';

            fetch('/Student/UpdateProgress', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify(payload)
            })
            .then(res => res.json())
            .then(data => {
                saveBtn.disabled = false;
                saveBtn.innerHTML = '<i class="bi bi-check2-circle me-1"></i> Save Progress';

                if (data.success) {
                    // Update local state map
                    const sData = studentDataMap[studentId];
                    if (sData) {
                        sData.overall = data.overallProgress;
                        sData.completed = subjectProgress.map(s => s.CompletedLectures);
                        sData.percentages = subjectProgress.map(s => s.TotalLectures > 0 ? (s.CompletedLectures / s.TotalLectures * 100) : 0);
                        
                        // Update visual progress bars and detail on the student card live
                        subjectProgress.forEach((sub, sIdx) => {
                            const detailEl = document.getElementById('cardSubDetail_' + studentId + '_' + sIdx);
                            const barEl = document.getElementById('cardSubBar_' + studentId + '_' + sIdx);
                            const pct = sub.TotalLectures > 0 ? (sub.CompletedLectures / sub.TotalLectures * 100) : 0;
                            if (detailEl) {
                                detailEl.innerHTML = '<strong>' + sub.CompletedLectures + '</strong>/' + sub.TotalLectures + ' (' + pct.toFixed(1) + '%)';
                            }
                            if (barEl) {
                                barEl.style.width = pct.toFixed(1) + '%';
                                barEl.setAttribute('aria-valuenow', pct.toFixed(1));
                                if (pct >= 100) {
                                    barEl.className = 'progress-bar rounded-pill bg-success';
                                } else if (pct > 0) {
                                    barEl.className = 'progress-bar rounded-pill bg-primary';
                                } else {
                                    barEl.className = 'progress-bar rounded-pill bg-light';
                                }
                            }
                        });

                        // Update donut chart
                        if (studentCharts['donut_' + studentId]) {
                            studentCharts['donut_' + studentId].data.datasets[0].data = [data.overallProgress, Math.max(0, 100 - data.overallProgress)];
                            studentCharts['donut_' + studentId].update();
                        }

                        // Update bar chart
                        if (studentCharts['bar_' + studentId]) {
                            studentCharts['bar_' + studentId].data.datasets[0].data = sData.percentages;
                            studentCharts['bar_' + studentId].update();
                        }

                        // Update text percentage
                        const pctText = document.getElementById('overallPercentText_' + studentId);
                        if (pctText) {
                            pctText.textContent = data.overallProgress.toFixed(1) + '%';
                        }
                    }

                    // Dynamically update the Syllabus fields in the Exam Evaluation modal with the completed lectures numbers
                    subjectProgress.forEach((sub, sIdx) => {
                        const count = parseInt(sub.CompletedLectures) || 0;
                        const sylText = count === 0 
                            ? "No lectures completed" 
                            : (count === 1 ? "Lecture 1" : `Lectures 1 to ${count}`);

                        const sylInput = document.getElementById(`examSyllabus_${studentId}_${sIdx}`);
                        if (sylInput) {
                            sylInput.value = sylText;
                        }

                        const countBadge = document.getElementById(`examLecCount_${studentId}_${sIdx}`);
                        if (countBadge) {
                            countBadge.textContent = `${count} of ${sub.TotalLectures} lectures completed`;
                        }

                        const cardSylEl = document.querySelector(`.cardSubSyllabus_${studentId}_${sIdx}`);
                        if (cardSylEl) {
                            if (count > 0) {
                                cardSylEl.classList.remove('d-none');
                                const span = cardSylEl.querySelector('span');
                                if (span) span.textContent = sylText;
                                cardSylEl.setAttribute('title', 'Syllabus: ' + sylText);
                            }
                        }
                    });

                    // Close Update Progress (Lectures) modal
                    const modalEl = document.getElementById('updateProgressModal-' + studentId);
                    if (modalEl) {
                        const modalInstance = bootstrap.Modal.getInstance(modalEl);
                        if (modalInstance) {
                            modalInstance.hide();
                        }
                    }

                    // Automatically open Exam Evaluation modal for completed lectures
                    const examModalEl = document.getElementById('examEvaluationModal-' + studentId);
                    if (examModalEl) {
                        setTimeout(() => {
                            const examModal = bootstrap.Modal.getOrCreateInstance(examModalEl);
                            examModal.show();

                            // Auto-focus the first grade dropdown so local guardian only needs to enter grades
                            setTimeout(() => {
                                const allGradeSelects = Array.from(examModalEl.querySelectorAll('select[name$=".Grade"]'));
                                const emptyGrade = allGradeSelects.find(s => !s.value);
                                const targetSelect = emptyGrade || allGradeSelects[0];
                                if (targetSelect) {
                                    targetSelect.focus();
                                }
                            }, 350);
                        }, 400);
                    }
                } else {
                    alert(data.message || 'Failed to update progress.');
                }
            })
            .catch(err => {
                console.error(err);
                saveBtn.disabled = false;
                saveBtn.innerHTML = '<i class="bi bi-check2-circle me-1"></i> Save Progress';
                alert('An error occurred while updating student progress.');
            });
        }

        // Auto-select grade dropdown based on marks input (NCTB scale)
        function autoSelectGradeFromMarks(studentId, sIdx, val) {
            const select = document.getElementById('examGrade_' + studentId + '_' + sIdx);
            if (!select) return;
            if (val === '' || val === null || isNaN(val)) {
                return;
            }
            const marks = parseFloat(val);
            if (marks >= 80) select.value = 'A+';
            else if (marks >= 70) select.value = 'A';
            else if (marks >= 60) select.value = 'A-';
            else if (marks >= 50) select.value = 'B';
            else if (marks >= 40) select.value = 'C';
            else if (marks >= 33) select.value = 'D';
            else select.value = 'F';
        }

        // Handle AJAX Submit of Exam Evaluation
        function submitExamEvaluation(event, studentId) {
            event.preventDefault();
            const form = document.getElementById('examForm_' + studentId);
            const saveBtn = document.getElementById('saveExamBtn_' + studentId);
            if (!form || !saveBtn) return;

            const formData = new FormData(form);
            const evaluations = [];

            let sIdx = 0;
            while (formData.has(`Evaluations[${sIdx}].SubjectName`)) {
                const subName = formData.get(`Evaluations[${sIdx}].SubjectName`);
                const syllabus = formData.get(`Evaluations[${sIdx}].Syllabus`) || '';
                const marksRaw = formData.get(`Evaluations[${sIdx}].Marks`);
                const marksVal = (marksRaw !== null && marksRaw !== '' && !isNaN(marksRaw)) ? parseFloat(marksRaw) : null;
                const gradeVal = formData.get(`Evaluations[${sIdx}].Grade`) || null;

                evaluations.push({
                    SubjectName: subName,
                    Syllabus: syllabus,
                    Marks: marksVal,
                    Grade: gradeVal
                });
                sIdx++;
            }

            const payload = {
                StudentId: studentId,
                Remarks: formData.get('Remarks') || '',
                Evaluations: evaluations
            };

            const token = form.querySelector('input[name="__RequestVerificationToken"]')?.value;

            saveBtn.disabled = true;
            saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Saving...';

            fetch('/Student/UpdateExamEvaluation', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify(payload)
            })
            .then(res => res.json())
            .then(data => {
                saveBtn.disabled = false;
                saveBtn.innerHTML = '<i class="bi bi-check2-circle me-1"></i> Save Exam Evaluation';

                if (data.success) {
                    // 1. Update overall grade badge on student card
                    const badgeWrap = document.getElementById('overallGradeBadgeWrap_' + studentId);
                    if (badgeWrap) {
                        if (data.hasExamEvaluation) {
                            badgeWrap.innerHTML = '<span class="badge ' + data.gradeBadgeClass + ' px-2.5 py-1 fw-bold rounded-pill" style="font-size: 0.82rem;" id="overallGradeBadge_' + studentId + '">Grade: ' + data.overallGrade + '</span>';
                        } else {
                            badgeWrap.innerHTML = '<span class="badge bg-light text-muted border px-2 py-1 rounded-pill small" id="overallGradeBadge_' + studentId + '">Not Evaluated</span>';
                        }
                    }

                    // 2. Update GPA text on card
                    const gpaText = document.getElementById('overallGpaText_' + studentId);
                    if (gpaText) {
                        gpaText.textContent = data.overallGPA || 'N/A';
                    }

                    // 3. Update evaluated subjects count on card
                    const evalCountText = document.getElementById('evaluatedCountText_' + studentId);
                    if (evalCountText) {
                        evalCountText.textContent = data.evaluatedCount;
                    }

                    // 4. Update each subject\'s Grade badge and Syllabus note in subject list
                    if (data.subjects && Array.isArray(data.subjects)) {
                        data.subjects.forEach((sub, idx) => {
                            const gradeEl = document.querySelector('.cardSubGradeBadge_' + studentId + '_' + idx);
                            if (gradeEl) {
                                gradeEl.textContent = sub.grade && sub.grade.trim() !== '' ? sub.grade : '—';
                                gradeEl.className = 'badge ' + sub.gradeBadgeClass + ' px-1.5 py-0.5 rounded-1 cardSubGradeBadge_' + studentId + '_' + idx;
                            }

                            const sylEl = document.querySelector('.cardSubSyllabus_' + studentId + '_' + idx);
                            if (sylEl) {
                                if (sub.syllabus && sub.syllabus.trim() !== '') {
                                    sylEl.classList.remove('d-none');
                                    const span = sylEl.querySelector('span');
                                    if (span) span.textContent = sub.syllabus;
                                    sylEl.setAttribute('title', 'Syllabus: ' + sub.syllabus);
                                } else {
                                    sylEl.classList.add('d-none');
                                }
                            }
                        });
                    }

                    // 5. Hide modal
                    const modalEl = document.getElementById('examEvaluationModal-' + studentId);
                    const modalInstance = bootstrap.Modal.getInstance(modalEl);
                    if (modalInstance) {
                        modalInstance.hide();
                    }

                    // 6. If eligible for promotion, reload to update promotion button state
                    if (data.canPromote) {
                        setTimeout(() => {
                            window.location.reload();
                        }, 600);
                    }
                } else {
                    alert(data.message || 'Failed to update exam evaluation.');
                }
            })
            .catch(err => {
                console.error(err);
                saveBtn.disabled = false;
                saveBtn.innerHTML = '<i class="bi bi-check2-circle me-1"></i> Save Exam Evaluation';
                alert('An error occurred while saving exam evaluation.');
            });
        }

        // ============================================
        // APPROACH A: LECTURE-BY-LECTURE EVALUATION
        // ============================================

        function openLectureEvalModal(studentId, studentName, classLvl, subjectName, lectureNo, topic, marks, grade, remarks, isEdit, sIdx) {
            document.getElementById('lecModalStudentId').value = studentId;
            document.getElementById('lecModalSubjectName').value = subjectName;
            document.getElementById('lecModalLectureNumber').value = lectureNo;
            document.getElementById('lecModalTopic').value = topic || ('Lecture ' + lectureNo);
            document.getElementById('lecModalMarks').value = (marks !== null && marks !== undefined) ? marks : '';
            document.getElementById('lecModalGrade').value = grade || 'A+';
            document.getElementById('lecModalRemarks').value = remarks || '';
            document.getElementById('lecModalIsDelete').value = 'false';
            document.getElementById('lecModalSIdx').value = sIdx;

            const titleEl = document.getElementById('singleLecModalTitle');
            if (titleEl) {
                titleEl.textContent = (isEdit ? 'Edit Evaluation: Lecture ' : 'Evaluate Lecture ') + lectureNo + ' (' + subjectName + ')';
            }

            const subTitleEl = document.getElementById('singleLecModalSubTitle');
            if (subTitleEl) {
                subTitleEl.textContent = studentName + ' | Class ' + classLvl;
            }

            const saveBtnText = document.getElementById('lecModalSaveBtnText');
            if (saveBtnText) {
                saveBtnText.textContent = isEdit ? 'Update Evaluation' : ('Save & Complete Lecture ' + lectureNo);
            }

            const revertBtn = document.getElementById('lecModalRevertBtn');
            if (revertBtn) {
                if (isEdit) {
                    revertBtn.classList.remove('d-none');
                } else {
                    revertBtn.classList.add('d-none');
                }
            }

            const modalEl = document.getElementById('singleLectureEvalModal');
            if (modalEl) {
                let modalInstance = bootstrap.Modal.getInstance(modalEl);
                if (!modalInstance) {
                    modalInstance = new bootstrap.Modal(modalEl);
                }
                modalInstance.show();

                setTimeout(() => {
                    const gradeSelect = document.getElementById('lecModalGrade');
                    if (gradeSelect) gradeSelect.focus();
                }, 350);
            }
        }

        function autoSelectLecGrade(val) {
            const select = document.getElementById('lecModalGrade');
            if (!select) return;
            if (val === '' || val === null || isNaN(val)) return;
            const marks = parseFloat(val);
            if (marks >= 80) select.value = 'A+';
            else if (marks >= 70) select.value = 'A';
            else if (marks >= 60) select.value = 'A-';
            else if (marks >= 50) select.value = 'B';
            else if (marks >= 40) select.value = 'C';
            else if (marks >= 33) select.value = 'D';
            else select.value = 'F';
        }

        function revertLectureCompletion() {
            const lecNo = document.getElementById('lecModalLectureNumber').value;
            const subName = document.getElementById('lecModalSubjectName').value;
            if (!confirm(`Are you sure you want to revert completion of Lecture ${lecNo} for ${subName}? This will decrement the completed lectures count.`)) {
                return;
            }
            document.getElementById('lecModalIsDelete').value = 'true';
            document.getElementById('singleLectureEvalForm').dispatchEvent(new Event('submit', { cancelable: true }));
        }

        function submitLectureEvaluation(event) {
            event.preventDefault();
            const form = document.getElementById('singleLectureEvalForm');
            const saveBtn = document.getElementById('lecModalSaveBtn');
            if (!form || !saveBtn) return;

            const studentId = parseInt(document.getElementById('lecModalStudentId').value);
            const subjectName = document.getElementById('lecModalSubjectName').value;
            const lectureNumber = parseInt(document.getElementById('lecModalLectureNumber').value);
            const isDelete = document.getElementById('lecModalIsDelete').value === 'true';
            const sIdx = parseInt(document.getElementById('lecModalSIdx').value) || 0;

            const topic = (document.getElementById('lecModalTopic').value || '').trim() || ('Lecture ' + lectureNumber);

            const marksRaw = document.getElementById('lecModalMarks').value;
            const marks = (marksRaw !== '' && !isNaN(marksRaw)) ? parseFloat(marksRaw) : null;
            const grade = document.getElementById('lecModalGrade').value || 'A+';
            const remarks = document.getElementById('lecModalRemarks').value || '';

            const payload = {
                StudentId: studentId,
                SubjectName: subjectName,
                LectureNumber: lectureNumber,
                Topic: topic,
                Marks: marks,
                Grade: grade,
                Remarks: remarks,
                IsDelete: isDelete
            };

            const token = form.querySelector('input[name="__RequestVerificationToken"]')?.value;

            saveBtn.disabled = true;
            saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Saving...';

            fetch('/Student/EvaluateLecture', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify(payload)
            })
            .then(res => res.json())
            .then(data => {
                saveBtn.disabled = false;
                saveBtn.innerHTML = '<i class="bi bi-check2-circle me-1"></i> <span id="lecModalSaveBtnText">Save & Complete Lecture</span>';

                if (data.success) {
                    // 1. Update overall card donut chart and overall text
                    const sData = studentDataMap[studentId];
                    if (sData) {
                        sData.overall = data.overallProgress;
                        if (sData.completed && sData.completed[sIdx] !== undefined) {
                            sData.completed[sIdx] = data.completedLectures;
                        }
                        if (sData.percentages && sData.percentages[sIdx] !== undefined) {
                            sData.percentages[sIdx] = data.subjectProgress;
                        }

                        if (studentCharts['donut_' + studentId]) {
                            studentCharts['donut_' + studentId].data.datasets[0].data = [data.overallProgress, Math.max(0, 100 - data.overallProgress)];
                            studentCharts['donut_' + studentId].update();
                        }
                        if (studentCharts['bar_' + studentId]) {
                            studentCharts['bar_' + studentId].data.datasets[0].data = sData.percentages;
                            studentCharts['bar_' + studentId].update();
                        }
                    }

                    const overallPctText = document.getElementById('overallPercentText_' + studentId);
                    if (overallPctText) {
                        overallPctText.textContent = data.overallProgress.toFixed(1) + '%';
                    }

                    // 2. Update overall Academic Grade badge and GPA text
                    const badgeWrap = document.getElementById('overallGradeBadgeWrap_' + studentId);
                    if (badgeWrap) {
                        if (data.overallGrade && data.overallGrade !== 'Not Evaluated') {
                            badgeWrap.innerHTML = '<span class="badge ' + data.gradeBadgeClass + ' px-2.5 py-1 fw-bold rounded-pill" style="font-size: 0.82rem;" id="overallGradeBadge_' + studentId + '">Grade: ' + data.overallGrade + '</span>';
                        } else {
                            badgeWrap.innerHTML = '<span class="badge bg-light text-muted border px-2 py-1 rounded-pill small" id="overallGradeBadge_' + studentId + '">Not Evaluated</span>';
                        }
                    }

                    const gpaText = document.getElementById('overallGpaText_' + studentId);
                    if (gpaText) {
                        gpaText.textContent = data.overallGPA || 'N/A';
                    }

                    // 3. Update Subject row detail & progress bar
                    const subDetail = document.getElementById('cardSubDetail_' + studentId + '_' + sIdx);
                    if (subDetail) {
                        subDetail.innerHTML = '<strong>' + data.completedLectures + '</strong>/' + data.totalLectures + ' (<span class="cardSubPct_' + studentId + '_' + sIdx + '">' + data.subjectProgress.toFixed(1) + '</span>%)';
                    }

                    const subBar = document.getElementById('cardSubBar_' + studentId + '_' + sIdx);
                    if (subBar) {
                        subBar.style.width = data.subjectProgress.toFixed(1) + '%';
                        subBar.setAttribute('aria-valuenow', data.subjectProgress.toFixed(1));
                        if (data.subjectProgress >= 100) {
                            subBar.className = 'progress-bar rounded-pill bg-success';
                        } else if (data.subjectProgress > 0) {
                            subBar.className = 'progress-bar rounded-pill bg-primary';
                        } else {
                            subBar.className = 'progress-bar rounded-pill bg-light';
                        }
                    }

                    // 4. Update Subject Grade badge & syllabus snippet
                    const subGradeBadge = document.querySelector('.cardSubGradeBadge_' + studentId + '_' + sIdx);
                    if (subGradeBadge) {
                        subGradeBadge.textContent = data.subjectGrade || '—';
                        subGradeBadge.className = 'badge ' + data.subjectGradeBadgeClass + ' px-1.5 py-0.5 rounded-1 cardSubGradeBadge_' + studentId + '_' + sIdx;
                    }

                    const subSyllabusEl = document.querySelector('.cardSubSyllabus_' + studentId + '_' + sIdx);
                    if (subSyllabusEl) {
                        if (data.subjectSyllabus && data.subjectSyllabus.trim() !== '') {
                            subSyllabusEl.classList.remove('d-none');
                            const span = subSyllabusEl.querySelector('span');
                            if (span) span.textContent = data.subjectSyllabus;
                        } else {
                            subSyllabusEl.classList.add('d-none');
                        }
                    }

                    // 5. Regenerate Lecture Milestone Badges (Approach A)
                    const badgesContainer = document.getElementById(`lectureBadges_${studentId}_${sIdx}`);
                    if (badgesContainer) {
                        const stName = badgesContainer.getAttribute('data-student-name') || '';
                        const cLvl = badgesContainer.getAttribute('data-class-level') || '1';
                        const sName = badgesContainer.getAttribute('data-subject-name') || subjectName;
                        const totalL = parseInt(badgesContainer.getAttribute('data-total-lectures')) || data.totalLectures;
                        const evals = data.evaluatedLectures || [];

                        let html = '';
                        for (let l = 1; l <= totalL; l++) {
                            const ev = evals.find(e => e.lectureNumber === l);
                            if (ev) {
                                const bg = getGradeBadgeBg(ev.grade);
                                const escapedTop = escapeJsString(ev.topic);
                                const escapedRem = escapeJsString(ev.remarks || '');
                                const marksVal = ev.marks !== null && ev.marks !== undefined ? ev.marks : 'null';
                                html += `<button type="button" 
                                                 class="btn btn-xs rounded-pill px-2 py-0.5 d-inline-flex align-items-center gap-1 border-0 shadow-2xs" 
                                                 style="${bg} font-size: 0.68rem; line-height: 1.1;" 
                                                 onclick="openLectureEvalModal(${studentId}, '${escapeJsString(stName)}', '${cLvl}', '${escapeJsString(sName)}', ${l}, '${escapedTop}', ${marksVal}, '${ev.grade}', '${escapedRem}', true, ${sIdx})" 
                                                 title="Lecture ${l} Completed: ${ev.topic} | Grade: ${ev.grade} | Marks: ${ev.marks !== null ? ev.marks : 'N/A'} (Click to edit)">
                                            <span>L${l}: ${ev.grade}</span>
                                            <i class="bi bi-check2"></i>
                                         </button> `;
                            } else if (l === data.completedLectures + 1) {
                                html += `<button type="button" 
                                                 class="btn btn-xs rounded-pill px-2 py-0.5 btn-outline-primary fw-semibold d-inline-flex align-items-center gap-1" 
                                                 style="font-size: 0.68rem; line-height: 1.1; border-style: dashed;" 
                                                 onclick="openLectureEvalModal(${studentId}, '${escapeJsString(stName)}', '${cLvl}', '${escapeJsString(sName)}', ${l}, '', null, 'A+', '', false, ${sIdx})" 
                                                 title="Click to evaluate exam & complete Lecture ${l}">
                                            <i class="bi bi-plus-circle-fill text-primary" style="font-size: 0.72rem;"></i>
                                            <span>L${l}</span>
                                         </button> `;
                            } else {
                                html += `<span class="badge bg-light text-muted border rounded-pill px-1.5 py-0.5" 
                                               style="font-size: 0.65rem; font-weight: normal; opacity: 0.7;" 
                                               title="Lecture ${l} (Complete previous lecture first)">L${l}</span> `;
                            }
                        }
                        badgesContainer.innerHTML = html;
                    }

                    // 6. Update Lecture History Drawer
                    const historyToggle = document.getElementById(`lecHistoryToggleText_${studentId}_${sIdx}`);
                    if (historyToggle) {
                        historyToggle.textContent = `${data.completedLectures} lectures evaluated (History)`;
                    }

                    const historyTbody = document.getElementById(`lecHistoryTableBody_${studentId}_${sIdx}`);
                    if (historyTbody) {
                        if (data.evaluatedLectures && data.evaluatedLectures.length > 0) {
                            historyTbody.innerHTML = data.evaluatedLectures.map(ev => `
                                <tr>
                                    <td><span class="badge bg-secondary-subtle text-secondary rounded-pill">L${ev.lectureNumber}</span></td>
                                    <td class="text-truncate" style="max-width: 100px;" title="${ev.topic}">${ev.topic}</td>
                                    <td>${ev.marks !== null ? ev.marks : '—'}</td>
                                    <td><span class="badge ${getGradeBadgeClass(ev.grade)} px-1 py-0.5 rounded-1">${ev.grade}</span></td>
                                </tr>
                            `).join('');
                        } else {
                            historyTbody.innerHTML = '<tr><td colspan="4" class="text-muted text-center fst-italic py-1">No lectures evaluated yet.</td></tr>';
                        }
                    }

                    // 7. Hide modal
                    const modalEl = document.getElementById('singleLectureEvalModal');
                    const modalInstance = bootstrap.Modal.getInstance(modalEl);
                    if (modalInstance) {
                        modalInstance.hide();
                    }

                    // 8. If promotion unlocked
                    if (data.canPromote) {
                        window.location.reload();
                    }
                } else {
                    alert(data.message || 'Failed to update lecture evaluation.');
                }
            })
            .catch(err => {
                console.error(err);
                saveBtn.disabled = false;
                saveBtn.innerHTML = '<i class="bi bi-check2-circle me-1"></i> Save & Complete Lecture';
                alert('An error occurred while saving lecture evaluation.');
            });
        }

        function getGradeBadgeBg(grade) {
            switch ((grade || '').trim().toUpperCase()) {
                case 'A+': return 'background-color: #15803d; color: #fff;';
                case 'A': return 'background-color: #16a34a; color: #fff;';
                case 'A-': return 'background-color: #0284c7; color: #fff;';
                case 'B': return 'background-color: #0d9488; color: #fff;';
                case 'C': return 'background-color: #eab308; color: #000;';
                case 'D': return 'background-color: #f97316; color: #fff;';
                case 'F': return 'background-color: #ef4444; color: #fff;';
                default: return 'background-color: #64748b; color: #fff;';
            }
        }

        function getGradeBadgeClass(grade) {
            switch ((grade || '').trim().toUpperCase()) {
                case 'A+': return 'bg-success text-white';
                case 'A': return 'bg-success-subtle text-success';
                case 'A-': return 'bg-primary-subtle text-primary';
                case 'B': return 'bg-info-subtle text-info-emphasis';
                case 'C': return 'bg-warning-subtle text-warning-emphasis';
                case 'D': return 'bg-secondary-subtle text-secondary';
                case 'F': return 'bg-danger text-white';
                default: return 'bg-light text-muted';
            }
        }

        function escapeJsString(str) {
            if (!str) return '';
            return str.replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/"/g, '&quot;');
        }
    </script>
}
