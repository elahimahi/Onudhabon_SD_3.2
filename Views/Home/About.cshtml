@{
    ViewData["Title"] = "About Us - Onudhabon";
}

<div class="about-page">
    <!-- Hero Section with Background Image -->
    <section class="about-hero">
        <div class="about-hero-overlay"></div>
        <div class="about-hero-content">
            <div class="about-hero-badge">
                <i class="bi bi-building"></i>
                <span>About Onudhabon</span>
            </div>
            <h1>Exploring Education Through Community</h1>
            <p>
                Onudhabon is a volunteer-led educational initiative working to make learning more accessible across Bangladesh. Volunteers and local guardians help underprivileged students, while our free lectures and study materials are open to everyone. Students and guardians can also use Onudhabon as a study guide.
            </p>
        </div>
    </section>

    <!-- Main Content Container -->
    <div class="container py-5" style="max-width: 980px;">
        <!-- Mission & Vision Row -->
        <div class="row g-4 mb-4">
            <div class="col-md-6">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 bg-white about-feature-card">
                    <div class="about-icon-badge badge-blue">
                        <i class="bi bi-flag-fill"></i>
                    </div>
                    <h4 class="fw-bold text-dark mb-2">Our Mission</h4>
                    <p class="text-secondary mb-0" style="line-height: 1.6;">
                        To democratize access to quality education by providing structured, curriculum-aligned video lectures and comprehensive study materials to every student regardless of geographic or financial boundaries.
                    </p>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 bg-white about-feature-card">
                    <div class="about-icon-badge badge-green">
                        <i class="bi bi-binoculars-fill"></i>
                    </div>
                    <h4 class="fw-bold text-dark mb-2">Our Vision</h4>
                    <p class="text-secondary mb-0" style="line-height: 1.6;">
                        A future where every child in Bangladesh has the mentorship, learning resources, and community encouragement needed to unlock their full academic potential and thrive.
                    </p>
                </div>
            </div>
        </div>

        <!-- Core Pillars -->
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white mb-4">
            <h3 class="fw-bold text-dark mb-4 text-center">What We Provide</h3>
            <div class="row g-4">
                <div class="col-md-6 col-lg-3 text-center about-feature-card">
                    <div class="about-icon-badge badge-blue">
                        <i class="bi bi-display-fill"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Video Lectures</h5>
                    <p class="text-muted small mb-0">High quality, topic-wise video lessons for Classes 1 to 12.</p>
                </div>
                <div class="col-md-6 col-lg-3 text-center about-feature-card">
                    <div class="about-icon-badge badge-teal">
                        <i class="bi bi-journal-bookmark-fill"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Study Materials</h5>
                    <p class="text-muted small mb-0">Downloadable worksheets, notes, and exam practice sheets.</p>
                </div>
                <div class="col-md-6 col-lg-3 text-center about-feature-card">
                    <div class="about-icon-badge badge-amber">
                        <i class="bi bi-chat-dots-fill"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Community Forum</h5>
                    <p class="text-muted small mb-0">Open discussions between educators, guardians, and students.</p>
                </div>
                <div class="col-md-6 col-lg-3 text-center about-feature-card">
                    <div class="about-icon-badge badge-rose">
                        <i class="bi bi-person-heart"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Local Guardians</h5>
                    <p class="text-muted small mb-0">Grassroots mentors facilitating student learning & enrollment.</p>
                </div>
            </div>
        </div>

        <!-- Quick Action / Get Involved -->
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 text-center bg-white">
            <h4 class="fw-bold text-dark mb-2">Join Our Mission</h4>
            <p class="text-muted mb-4 mx-auto" style="max-width: 600px;">
                        Volunteers and local guardians can help underprivileged learners. Students, guardians, and anyone looking for learning resources can freely explore our lectures and study materials.
            </p>
            <div class="d-flex justify-content-center gap-3 flex-wrap">
                <a asp-controller="Lecture" asp-action="Index" class="btn btn-primary rounded-pill px-4 py-2" style="background: linear-gradient(135deg, #1e3a8a 0%, #1d4ed8 100%); border: none;">
                    Watch Lectures
                </a>
                <a asp-controller="Material" asp-action="Index" class="btn btn-outline-primary rounded-pill px-4 py-2">
                    Browse Materials
                </a>
                <a asp-controller="Donation" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2">
                    Support with Donation
                </a>
            </div>
        </div>
    </div>
</div>
