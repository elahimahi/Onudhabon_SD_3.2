@model Onudhabon.Models.MaterialUploadViewModel
@{
    ViewData["Title"] = "AI Assisted Study Material Upload - Onudhabon";
}

<div class="container py-5">
    <div class="row justify-content-center"><div class="col-lg-9 col-xl-8">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill mb-3">← Back to Materials</a>
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="rounded-circle bg-primary-subtle text-primary d-inline-flex p-3 mb-2"><i class="bi bi-stars fs-3"></i></div>
                <h2 class="fw-bold">Upload Study Material with AI</h2>
                <p class="text-muted mb-1">Choose your document. AI will read it and draft the title, class, subject, topic and description.</p>
                <small class="text-muted">You review and edit the suggestions before submitting for approval.</small>
            </div>
            <form id="materialUploadForm" asp-action="Upload" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3"></div>
                <div class="mb-3">
                    <label asp-for="MaterialFile" class="form-label fw-semibold">Study material document *</label>
                    <input asp-for="MaterialFile" type="file" accept=".pdf,.docx,.pptx" class="form-control form-control-lg" required />
                    <div class="form-text">Text based PDF, DOCX or PPTX · up to 25 MB. Scanned image-only PDFs and old DOC/PPT files cannot be analyzed yet.</div>
                    <span asp-validation-for="MaterialFile" class="text-danger small"></span>
                </div>
                <div id="materialAiStatus" class="small mb-3" role="status" aria-live="polite"></div>
                <button id="analyzeMaterialButton" type="button" class="btn btn-outline-primary rounded-pill px-4 mb-4"><i class="bi bi-stars me-1"></i> Analyze document with AI</button>

                <section id="materialDraft" class="border rounded-4 p-3 p-md-4 bg-light" hidden>
                    <h5 class="fw-bold mb-1">Review AI draft</h5>
                    <p class="text-muted small">AI suggestions can be wrong. Confirm the details against the document before submitting.</p>
                    <div class="mb-3"><label asp-for="Title" class="form-label fw-semibold">Material title *</label><input asp-for="Title" class="form-control" maxlength="255" required /><span asp-validation-for="Title" class="text-danger small"></span></div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-4"><label asp-for="ClassLevel" class="form-label fw-semibold">Class *</label><select asp-for="ClassLevel" class="form-select" required><option value="">Choose class</option>@for (var i = 1; i <= 12; i++) { <option value="@i">Class @i</option> }</select></div>
                        <div class="col-md-4"><label asp-for="Subject" class="form-label fw-semibold">Subject *</label><input asp-for="Subject" class="form-control" maxlength="100" required /></div>
                        <div class="col-md-4"><label asp-for="Topic" class="form-label fw-semibold">Topic *</label><input asp-for="Topic" class="form-control" maxlength="150" required /></div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6"><label asp-for="Version" class="form-label fw-semibold">Medium / Version</label><select asp-for="Version" class="form-select"><option value="Bangla">Bangla Medium</option><option value="English">English Medium</option><option value="English Version">English Version</option></select></div>
                        <div class="col-md-6"><label asp-for="Instructor" class="form-label fw-semibold">Educator / Author</label><input asp-for="Instructor" class="form-control" readonly /></div>
                    </div>
                    <div class="mb-4"><label asp-for="Description" class="form-label fw-semibold">Document description</label><textarea asp-for="Description" rows="4" class="form-control" maxlength="2000"></textarea></div>
                    <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill">Review and submit material (Pending approval)</button>
                </section>
            </form>
        </div>
    </div></div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const form = document.getElementById('materialUploadForm');
            const file = document.getElementById('MaterialFile');
            const analyze = document.getElementById('analyzeMaterialButton');
            const draft = document.getElementById('materialDraft');
            const status = document.getElementById('materialAiStatus');
            let analyzedFile = '';
            file.addEventListener('change', () => { draft.hidden = true; analyzedFile = ''; status.textContent = ''; });
            analyze.addEventListener('click', async () => {
                if (!file.files.length) { status.className = 'small mb-3 text-danger'; status.textContent = 'Choose a document first.'; return; }
                const data = new FormData(form);
                analyze.disabled = true; status.className = 'small mb-3 text-primary'; status.textContent = 'AI is reading the document…';
                try {
                    const response = await fetch('@Url.Action("AnalyzeUpload", "Material")', { method: 'POST', body: data, headers: { 'RequestVerificationToken': form.querySelector('[name="__RequestVerificationToken"]').value } });
                    const result = await response.json();
                    if (!response.ok) throw new Error(result.error || 'Analysis failed. Please try again.');
                    const values = result.draft;
                    for (const key of ['Title', 'Description', 'ClassLevel', 'Subject', 'Topic', 'Version']) {
                        const field = document.getElementById(key);
                        if (field) field.value = values[key.charAt(0).toLowerCase() + key.slice(1)] || '';
                    }
                    analyzedFile = file.files[0].name + ':' + file.files[0].size + ':' + file.files[0].lastModified;
                    draft.hidden = false; status.className = 'small mb-3 text-success'; status.textContent = 'Draft ready. Review and correct the suggested details below.';
                    draft.scrollIntoView({ behavior: 'smooth', block: 'start' });
                } catch (error) { status.className = 'small mb-3 text-danger'; status.textContent = error.message; }
                finally { analyze.disabled = false; }
            });
            form.addEventListener('submit', event => {
                const current = file.files[0];
                const signature = current ? current.name + ':' + current.size + ':' + current.lastModified : '';
                if (!draft.hidden && signature !== analyzedFile) { event.preventDefault(); status.className = 'small mb-3 text-danger'; status.textContent = 'The selected file changed. Analyze it again before submitting.'; }
            });
        })();
    </script>
}
